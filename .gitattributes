#
# Line ending normalization
# https://docs.github.com/en/get-started/git-basics/configuring-git-to-handle-line-endings
#

# Normalize all detected text files and store them as LF
*               text=auto eol=lf

# Windows scripts should use CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary files should be left untouched
*.exe           binary
bin/terranova   binary
*.jar           binary
*.zip           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.bin           binary
*.dat           binary
*.db            binary
*.sqlite        binary
*.sqlite3       binary
# Fixtures sind byteweise Vergleichsdateien - die Zeilenenden gehoeren dazu
terranova/tests/fixtures/** -text
