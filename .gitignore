# MacOS
.DS_Store

# IntelliJ
.idea/
*.iml
out/

# ---------------------------------------------------------------------------
# servers/          die drei festen Server. Was dort liegt, ist was laeuft -
#                   Paper, die Plugin-Jars, die Configs. Alles versioniert,
#                   damit ein Klon ohne Zwischenschritt startklar ist und
#                   mehrere daran arbeiten koennen.
#
# servers_dynamic/  die Dungeons. Sie entstehen aus templates/, leben einen
#                   Tag und verschwinden - nichts davon gehoert ins
#                   Repository.
#
# templates/        nur noch fuer die Dungeons: common/ ist die gemeinsame
#                   Grundlage, daneben je Dungeon-Art eine Vorlage.
#
# Faustregel: was Paper, ein Plugin oder Terranova selbst wiederherstellen
# kann, wird nicht committet. Und nichts, worin ein Geheimnis steht.
# ---------------------------------------------------------------------------

# Rust-Baustelle
terranova/target/

# Von start.bat heruntergeladen und angelegt: MariaDB und Redis samt Daten
runtime/

# Die beiden Dateien je festem Server, in die Terranova beim Start ein
# Geheimnis schreibt: das RCON-Passwort und das Forwarding-Secret. Sie
# entstehen aus den .dist-Dateien daneben - und die gehoeren ins Repository.
servers/*/server.properties
servers/*/config/paper-global.yml

# Wer wo Operator ist, wer gesperrt ist: haengt an Spielern und an diesem
# einen Netzwerk, nicht am Server selbst. Paper legt die Dateien beim Start
# leer an, wenn sie fehlen. Ein OP wird ueber die Konsole gesetzt, die Rechte
# verwaltet ohnehin LuckPerms.
servers/*/ops.json
servers/*/whitelist.json
servers/*/banned-players.json
servers/*/banned-ips.json

# Was Plugins sich zur Laufzeit merken. Alles davon leitet sich aus der Welt
# oder aus dem ab, was Spieler getan haben - und die Welten sind nicht
# versioniert, also waere es hier ohnehin nur ein Stand von gestern.
servers/*/plugins/TAB/playerdata.yml
servers/*/plugins/Proficisci/storage/
servers/*/plugins/BountyfulSeas/water_regions.bin
# Liste dessen, was terranova sync einmal hierher kopiert hat
servers/*/.terranova-sync.json

# Dungeons: entstehen aus templates/, werden nach 24 h verworfen
servers_dynamic/
# Aus der Zeit, als sie noch neben den festen Servern lagen - der naechste
# Start verschiebt sie hinueber.
servers/mining-*/

# Velocity: das Secret ist der einzige Schutz der Backends und gehoert nicht
# ins Repository. Das Velocity-Jar dagegen schon - es ist keine Kopie aus
# templates/, sondern das einzige Exemplar, und ohne es startet ein frischer
# Klon nicht.
proxy/forwarding.secret
proxy/logs/
proxy/lang/

# Von Paper heruntergeladen oder erzeugt
**/cache/
**/libraries/
**/versions/
**/logs/
servers/*/world/
servers/*/world_nether/
servers/*/world_the_end/
templates/*/world/
**/usercache.json
**/.console_history
**/.paper/
*.log

# Heruntergeladene Abhaengigkeiten und Uebersetzungen der Plugins
**/plugins/**/libs/
**/plugins/**/lib/
**/plugins/**/translations/

# Von BountyfulSeas zur Laufzeit aus dem eigenen Jar ausgepackt
**/plugins/BountyfulSeas/bin/

# Laufzeitausgabe der Plugins
**/plugins/**/*.log
**/plugins/**/*.log.lck
**/plugins/**/.assetCache/
**/plugins/**/.deobfCachedPacks/
**/plugins/**/packsquash/
**/plugins/**/.cache/
**/plugins/**/.meta/
**/plugins/bStats/
**/plugins/spark/
**/plugins/faststats/

# Lokale Datenbanken (die echten Daten liegen in MariaDB)
**/plugins/**/*.db
**/plugins/**/*.sqlite
**/plugins/**/*.mv.db

# Generierte Ausgabe einzelner Plugins
# Von BountyfulSeas aus den Fischdefinitionen erzeugt. Wird bei jedem Start
# neu geschrieben und vergibt custom_model_data neu, was bei parallelem
# Arbeiten Konflikte und doppelte IDs erzeugt hat. Die Quelle sind die
# Dateien unter BountyfulSeas/fishes - neue Items dort eintragen.
**/plugins/Nexo/items/bountyfulseas/fish.yml
**/plugins/Nexo/pack/pack.zip
**/plugins/Pl3xMap/web/tiles/
**/plugins/FastAsyncWorldEdit/history/
**/plugins/FastAsyncWorldEdit/clipboard/
