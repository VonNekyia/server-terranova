# MacOS
.DS_Store

# IntelliJ
.idea/
*.iml
out/

# ---------------------------------------------------------------------------
# Die festen Server liegen unter network/local/services/<name>/ und werden
# versioniert - Plugin-Jars, Plugin-Configs und Serverconfig gehoeren ins
# Repository. Dasselbe gilt fuer die Templates unter network/local/templates/,
# aus denen CloudNet die Dungeons erzeugt.
#
# Ausgenommen ist alles, was zur Laufzeit entsteht oder heruntergeladen wird.
# Faustregel: was start.bat, CloudNet, Paper oder ein Plugin selbst
# wiederherstellen kann, wird nicht committet.
# ---------------------------------------------------------------------------

# Von start.bat heruntergeladen und angelegt: MariaDB und Redis samt Daten
runtime/

# Von CloudNet selbst heruntergeladen oder erzeugt
network/launcher/
network/modules/
network/temp/
network/.wrapper/
network/config.json
network/launcher.cnl
network/local/registry
network/local/perms.json
network/local/records/
network/local/database/
network/local/.consolehistory

# Dynamische Dungeons: entstehen aus dem Template und werden nach 24 h verworfen.
# Nur das Template unter network/local/templates/mining/ ist die Quelle.
network/local/services/mining-*/

# Velocity-Forwarding-Secret: wird beim ersten Start erzeugt und gehoert
# ausdruecklich nicht ins Repository
**/forwarding.secret

# Von Paper heruntergeladen oder erzeugt
**/cache/
**/libraries/
**/versions/
**/logs/
network/local/services/*/world/
network/local/services/*/world_nether/
network/local/services/*/world_the_end/
network/local/templates/*/*/world/
network/local/templates/*/*/world_nether/
network/local/templates/*/*/world_the_end/
**/usercache.json
**/.console_history
**/.paper/
*.log

# Heruntergeladene Abhaengigkeiten und Uebersetzungen der Plugins
**/plugins/**/libs/
**/plugins/**/lib/
**/plugins/**/translations/

# Von BountyfulSeas zur Laufzeit aus dem eigenen Jar ausgepackt
**/plugins/BountyfulSeas/bin/

# Laufzeitausgabe der Plugins
**/plugins/**/*.log
**/plugins/**/*.log.lck
**/plugins/**/.assetCache/
**/plugins/**/.deobfCachedPacks/
**/plugins/**/packsquash/
**/plugins/**/.cache/
**/plugins/**/.meta/
**/plugins/bStats/
**/plugins/spark/
**/plugins/faststats/

# Lokale Datenbanken (die echten Daten liegen in MariaDB)
**/plugins/**/*.db
**/plugins/**/*.sqlite
**/plugins/**/*.mv.db

# Generierte Ausgabe einzelner Plugins
# Von BountyfulSeas aus den Fischdefinitionen erzeugt. Wird bei jedem Start
# neu geschrieben und vergibt custom_model_data neu, was bei parallelem
# Arbeiten Konflikte und doppelte IDs erzeugt hat. Die Quelle sind die
# Dateien unter BountyfulSeas/fishes - neue Items dort eintragen.
**/plugins/Nexo/items/bountyfulseas/fish.yml
**/plugins/Nexo/pack/pack.zip
**/plugins/Pl3xMap/web/tiles/
**/plugins/FastAsyncWorldEdit/history/
**/plugins/FastAsyncWorldEdit/clipboard/
