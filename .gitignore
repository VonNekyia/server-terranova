# MacOS
.DS_Store

# IntelliJ
.idea/
*.iml
out/

# Altes Arbeitsverzeichnis
run/

# ---------------------------------------------------------------------------
# server/ IST der Arbeitsordner und wird versioniert: Plugin-Jars, Plugin-
# Configs, Serverconfig und start.bat gehoeren ins Repository.
#
# Ausgenommen ist alles, was zur Laufzeit entsteht oder heruntergeladen wird.
# Faustregel: was start.bat, Paper oder ein Plugin selbst wiederherstellen
# kann, wird nicht committet.
# ---------------------------------------------------------------------------

# Von start.bat heruntergeladen und angelegt
server/mariadb/

# Von Paper heruntergeladen oder erzeugt
server/cache/
server/libraries/
server/versions/
server/logs/
server/world/
server/world_nether/
server/world_the_end/
server/usercache.json
server/*.log
server/.console_history
server/.paper/

# Abgeloest: MariaDB, Datenbankanlage und Sync laufen jetzt in start.bat
server/plugins/Interconnect/
server/plugins/Interconnect-*.jar

# Heruntergeladene Abhaengigkeiten und Uebersetzungen der Plugins
server/plugins/**/libs/
server/plugins/**/lib/
server/plugins/**/translations/

# Von BountyfulSeas zur Laufzeit aus dem eigenen Jar ausgepackt
server/plugins/BountyfulSeas/bin/

# Laufzeitausgabe der Plugins
server/plugins/**/logs/
server/plugins/**/*.log
server/plugins/**/*.log.lck
server/plugins/**/.assetCache/
server/plugins/**/.deobfCachedPacks/
server/plugins/**/packsquash/
server/plugins/**/.cache/
server/plugins/**/.meta/
server/plugins/bStats/
server/plugins/spark/
server/plugins/faststats/

# Lokale Datenbanken (die echten Daten liegen in MariaDB)
server/plugins/**/*.db
server/plugins/**/*.sqlite
server/plugins/**/*.mv.db

# Generierte Ausgabe einzelner Plugins
server/plugins/Nexo/pack/pack.zip
server/plugins/Pl3xMap/web/tiles/
server/plugins/FastAsyncWorldEdit/history/
server/plugins/FastAsyncWorldEdit/clipboard/
